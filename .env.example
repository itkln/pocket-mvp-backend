COMPOSE_PROJECT_NAME=pocket-mvp

POSTGRES_DB=pocket
POSTGRES_USER=pocket
POSTGRES_PASSWORD=pocket_local_password
POSTGRES_PORT=5432

BACKEND_PORT=8080
VENDOR_PORT=3000
DISH_PORT=3001
NEXT_PUBLIC_API_URL=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

APP_ENV=development
LOG_LEVEL=info
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECT_TIMEOUT=15s
SHUTDOWN_TIMEOUT=10s

# Replace both values in every non-local environment: openssl rand -base64 32
DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
DATA_LOOKUP_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTA=
SESSION_COOKIE_NAME=pocket_session
SESSION_TTL=720h
COOKIE_SECURE=false

# Password recovery. Without SMTP_ADDRESS, development reset links are written
# to backend logs. Configure SMTP in production.
APP_BASE_URL=http://localhost:3000
# Optional explicit Vendor override; APP_BASE_URL remains the legacy fallback.
VENDOR_APP_BASE_URL=http://localhost:3000
DISH_APP_BASE_URL=http://localhost:3001
PASSWORD_RESET_TTL=30m
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# Local demo workspace. Change these before running `make seed-demo` if needed.
DEMO_EMAIL=demo@pocket.local
DEMO_PASSWORD=PocketDemo123!
ALLOW_DEMO_SEED=false
